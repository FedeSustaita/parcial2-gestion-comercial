# Base de datos
# Local: archivo SQLite (se crea solo al correr db:migrate)
# Producción (Vercel): URL libsql de Turso, ej. libsql://parcial2-usuario.turso.io
DATABASE_URL=file:local.db
# Solo en producción (Turso). En local queda vacío.
DATABASE_AUTH_TOKEN=

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Este valor es SOLO para desarrollo local. En Vercel generar uno nuevo con:
#   openssl rand -base64 32
SESSION_SECRET=dev-secreto-local-cambiar-en-produccion-123456
